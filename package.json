{
  "name": "arc-browser-mcp",
  "version": "0.2.3",
  "description": "MCP server to drive the Arc browser on macOS via a live AppleScript engine and a CDP engine.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "arc",
    "arc-browser",
    "browser-automation",
    "applescript",
    "cdp",
    "chrome-devtools-protocol",
    "playwright",
    "macos",
    "ai-agent"
  ],
  "homepage": "https://github.com/Mukbeast4/arc-browser-mcp#readme",
  "bugs": "https://github.com/Mukbeast4/arc-browser-mcp/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mukbeast4/arc-browser-mcp.git"
  },
  "license": "MIT",
  "author": "Mukbeast4",
  "type": "module",
  "bin": { "arc-browser-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "files": ["dist", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "bun run build",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "ARC_MCP_E2E=1 bun test tests/e2e",
    "check": "bun run typecheck && bun run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "playwright-core": "1.60.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "typescript": "6.0.3"
  }
}
